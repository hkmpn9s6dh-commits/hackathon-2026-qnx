{
  "name": "bootprint",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Bootprint — a QNX system image workbench: parse, inspect and replay a .build file before it touches hardware.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -b --noEmit false --emitDeclarationOnly false",
    "verify": "bash scripts/verify.sh"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "playwright-core": "^1.65.0",
    "tsx": "^4.23.15",
    "typescript": "~5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
