# A "trimmed" image that lost two lines in a refactor.
# It builds. It flashes. It does not run.

[virtual=x86_64,multiboot] boot = {
    startup-x86 -v
    PATH=/proc/boot
    procnto-smp-instr
}

[+script] startup-script = {
    display_msg Telemetry node — image 214

    SYSNAME=nto
    TERM=qansi

    devc-ser8250 &
    waitfor /dev/ser1
    reopen /dev/ser1

    [+session] sh &
}

[type=link] /tmp=/dev/shmem
[type=link] /bin/sh=/proc/boot/ksh
[type=link] /dev/console=/dev/ser1

# Two entries claim the same node; the second one wins silently.
[perms=0644] /etc/telemetry.conf
[perms=0666] /etc/telemetry.conf

# The loader moved into the per-arch directory months ago and never came back.
/usr/lib/ldqnx.so.2=ldqnx.so.2

echo
cat
ls
pidin
sh
devc-ser8250
telemetry-agent
